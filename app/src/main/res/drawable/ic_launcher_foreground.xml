<?xml version="1.0" encoding="utf-8"?>
<!--
  «نداء / Nidaa» icon — foreground layer, "the call".

  No letters, no monogram. A gold crescent in the upper-right (the night sky
  the call rises from) plus three thin concentric arcs with rounded caps at
  ~70 / 45 / 25 % opacity: the sound of the adhan travelling outwards. Two to
  three tiny four-point stars complete the Living Sky.

  Every element is inside the 66 dp safe zone (circle of radius 33 around the
  54,54 centre), so the circle, squircle and rounded-square masks never clip
  it.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Crescent: outer disc minus an offset bite, opening to the lower-left.
         Opposing winding directions leave exactly the crescent visible. -->
    <path
        android:fillColor="#FFD98A"
        android:pathData="M49.5,41 A14.5,14.5 0 1 1 78.5,41 A14.5,14.5 0 1 1 49.5,41 Z
                          M43.5,48.5 A13,13 0 1 0 69.5,48.5 A13,13 0 1 0 43.5,48.5 Z" />

    <!-- Three echoes of the call, radiating from the crescent centre (64,41). -->
    <path
        android:pathData="M62.30,60.43 A19.5,19.5 0 0 1 46.33,32.76"
        android:strokeColor="#B3FFD98A"
        android:strokeWidth="2.2"
        android:strokeLineCap="round"
        android:fillColor="#00000000" />

    <path
        android:pathData="M61.82,65.91 A25,25 0 0 1 41.34,30.43"
        android:strokeColor="#73FFD98A"
        android:strokeWidth="2.2"
        android:strokeLineCap="round"
        android:fillColor="#00000000" />

    <path
        android:pathData="M61.34,71.38 A30.5,30.5 0 0 1 36.36,28.11"
        android:strokeColor="#40FFD98A"
        android:strokeWidth="2.2"
        android:strokeLineCap="round"
        android:fillColor="#00000000" />

    <!-- Tiny four-point stars, 40-60 % opacity. -->
    <path
        android:fillColor="#8CFFF6E0"
        android:pathData="M80,54.4 L80.9,56.1 L82.6,57 L80.9,57.9 L80,59.6 L79.1,57.9 L77.4,57 L79.1,56.1 Z" />
    <path
        android:fillColor="#73FFF6E0"
        android:pathData="M46,24 L46.7,25.3 L48,26 L46.7,26.7 L46,28 L45.3,26.7 L44,26 L45.3,25.3 Z" />
    <path
        android:fillColor="#99FFF6E0"
        android:pathData="M72,69.6 L72.6,70.9 L73.9,71.5 L72.6,72.1 L72,73.4 L71.4,72.1 L70.1,71.5 L71.4,70.9 Z" />
</vector>
