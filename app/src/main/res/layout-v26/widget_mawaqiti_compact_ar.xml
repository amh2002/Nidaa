<?xml version="1.0" encoding="utf-8"?>
<!--
  beta 7.95: COMPACT main widget, ARABIC reading order.

  Selected by WidgetUpdater only while the placed instance is narrower than
  COMPACT_WIDTH_DP (220dp). It shows the same next-prayer data large instead of
  squeezing six cells into a narrow strip. The moment the instance is wide
  again, renderForSize picks the full grid again — both directions go through
  the same function, so a restored instance is byte-identical to a fresh add.

  API 26+ autosizing twin; res/layout holds the fixed-size fallback.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_compact_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:layoutDirection="ltr"
    android:orientation="vertical"
    android:padding="8dp">

    <!-- City on the LEFT, wordmark on the RIGHT (same anchors as the full AR
         layout, mirrored explicitly in XML so the launcher cannot flip them). -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/widget_compact_city"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="@dimen/widget_row_gap"
            android:layout_weight="1"
            android:ellipsize="end"
            android:gravity="start|center_vertical"
            android:maxLines="1"
            android:autoSizeTextType="uniform"
                android:autoSizeMinTextSize="8sp"
                android:autoSizeMaxTextSize="16sp"
                android:autoSizeStepGranularity="1sp"
                android:textColor="@color/widget_text"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_compact_wordmark"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="end|center_vertical"
            android:maxLines="1"
            android:autoSizeTextType="uniform"
                android:autoSizeMinTextSize="8sp"
                android:autoSizeMaxTextSize="14sp"
                android:autoSizeStepGranularity="1sp"
                android:textColor="@color/widget_gold"
            android:textSize="14sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Next prayer: name above, time below, both filling the middle. -->
    <TextView
        android:id="@+id/widget_compact_name"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:ellipsize="end"
        android:gravity="center"
        android:maxLines="1"
        android:autoSizeTextType="uniform"
        android:autoSizeMinTextSize="5sp"
        android:autoSizeMaxTextSize="20sp"
        android:autoSizeStepGranularity="1sp"
        android:textColor="@color/widget_text_muted"
        android:textSize="20sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/widget_compact_time"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="2"
        android:ellipsize="end"
        android:gravity="center"
        android:maxLines="1"
        android:autoSizeTextType="uniform"
        android:autoSizeMinTextSize="10sp"
        android:autoSizeMaxTextSize="48sp"
        android:autoSizeStepGranularity="1sp"
        android:includeFontPadding="false"
        android:textColor="@color/widget_text"
        android:textSize="48sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/widget_compact_left"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:background="@drawable/widget_gold_pill"
        android:ellipsize="end"
        android:maxLines="1"
        android:paddingStart="8dp"
        android:paddingTop="2dp"
        android:paddingEnd="8dp"
        android:paddingBottom="2dp"
        android:autoSizeTextType="uniform"
        android:autoSizeMinTextSize="7sp"
        android:autoSizeMaxTextSize="14sp"
        android:autoSizeStepGranularity="1sp"
        android:textColor="@color/widget_gold"
        android:textSize="14sp"
        android:textStyle="bold" />
</LinearLayout>
