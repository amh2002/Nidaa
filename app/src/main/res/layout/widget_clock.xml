<?xml version="1.0" encoding="utf-8"?>
<!--
  beta28: the transparent clock widget.

  One full-size ImageView, nothing else. ClockWidgetProvider draws the entire
  design (huge gradient-faded digits with the calligraphic Arabic day name in
  front of them) into a bitmap sized to this widget's real footprint and pushes
  it with setImageViewBitmap. RemoteViews cannot do text gradients, calligraphic
  shaping or true z-order overlap between two views, which is why beta28 replaced
  the TextClock/TextView stack with a single canvas render.

  No background of any kind: the wallpaper shows through.
  `src` is only the static picker/preview image (also used by previewLayout on
  API 31+); the real content replaces it on the first update.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/clock_widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/transparent">

    <ImageView
        android:id="@+id/clock_widget_image"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@string/clock_widget_label"
        android:scaleType="fitXY"
        android:src="@drawable/clock_widget_preview_png" />
</FrameLayout>
